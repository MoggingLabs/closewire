prompts/

# ── OS / editor ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Pacing state (persisted circuit-breaker halt) -- local runtime state, never shared.
.closewire/

# Validation screenshots: real client/consumer PII from a live account.
