# ─────────────────────────────────────────────────────────────────────
#  Closewire — local configuration
#  Copy this file to `.env` and fill in YOUR values.
#  `.env` is gitignored and must NEVER be committed. Placeholders only here.
# ─────────────────────────────────────────────────────────────────────

# Your Closebot API key (Closebot dashboard → API / integrations).
CLOSEBOT_API_KEY=paste-your-closebot-api-key-here

# (Optional) Override the Closebot REST API base URL. Default: https://api.closebot.com
CLOSEBOT_API_BASE=
# (Optional) Override the Closebot live-message runtime URL. Default: https://api.closebot.ai/message
CLOSEBOT_LIVE_BASE=
# (Optional) Closebot web app, used only by the build-time UI validation loop — the
# client never calls it. Default: https://app.closebot.com
CLOSEBOT_UI_BASE=

# (Optional) Auth header form for the REST host `CLOSEBOT_API_BASE` (api.closebot.com).
#   x-cb-key | authorization-key (`Authorization: Key <key>`) | authorization-bearer (`Bearer <key>`)
#
# SCOPE: this reaches the REST host ONLY. It does NOT apply to the runtime host
# `api.closebot.ai/message`, which is pinned to `x-cb-key` — the two hosts document different
# conventions, and inheriting one into the other would change what goes on the wire to the
# credit-spending endpoint. See deviation 29 in docs/validation/09-runtime.md.
# Setting this to anything else logs a WARNING naming both hosts, so the divergence is not
# silent. To vary the runtime host's form, pass `LiveMessageClient(auth_style=...)`.
CLOSEWIRE_AUTH_STYLE=x-cb-key

# ── Pacing / safety knobs (safe defaults; tune down, rarely up) ──────
# Minimum + maximum think-time between actions, in seconds (randomized).
CLOSEWIRE_MIN_DELAY_S=1.0
CLOSEWIRE_MAX_DELAY_S=4.0
# Writes are held stricter than reads: this multiplies the delay above, on top of
# being serialized (only ever one write in flight).
CLOSEWIRE_WRITE_DELAY_MULT=2.0
# Extra random jitter added to every delay, so gaps are never a clean interval.
CLOSEWIRE_JITTER_S=0.35
# How many reads may be in flight at once. Writes are always 1.
CLOSEWIRE_MAX_READ_CONCURRENCY=3

# Hard hourly ceilings so a runaway job can't hammer the API. On a hit, calls BLOCK
# until the sliding window frees — they are never dropped.
CLOSEWIRE_MAX_OPS_PER_HOUR=300
CLOSEWIRE_MAX_WRITES_PER_HOUR=60

# Retry/backoff for 429 + 403. The computed delay is base * 2^attempt plus jitter,
# capped at BACKOFF_CAP_S. Max 32 retries.
CLOSEWIRE_MAX_RETRIES=4
CLOSEWIRE_BACKOFF_BASE_S=2.0
CLOSEWIRE_BACKOFF_CAP_S=60.0
CLOSEWIRE_BACKOFF_JITTER_S=1.0
# An explicit `Retry-After` from the server is obeyed AS GIVEN — never shortened to the
# cap above. If the server asks for longer than this, we stop retrying and tell you
# rather than quietly coming back sooner than we were asked to.
CLOSEWIRE_RETRY_AFTER_MAX_S=900

# Circuit breaker: recent failures before ALL traffic halts pending a manual reset.
# Keep these low — a tripped breaker is how you find out something is wrong.
# A trip is written to CLOSEWIRE_STATE_DIR so the halt survives a restart; clear it with
# `closewire pacing-reset` once you have investigated.
CLOSEWIRE_BREAKER_AUTH_THRESHOLD=3
CLOSEWIRE_BREAKER_429_THRESHOLD=5
CLOSEWIRE_STATE_DIR=.closewire

# Set to 1 to preview writes without sending them (still logged + counted).
CLOSEWIRE_DRY_RUN=0
